{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"arrowParens": "always",
	"bracketSameLine": false,
	"ignorePatterns": [
		"*.jsonc",
		"pnpm-lock.yaml",
		"dist/",
		"generated/",
		"node_modules/",
		"*.generated.*",
		"coverage/",
		".git/",
		"*.yml",
		"*.yaml",
		"*.toml",
		"*.html",
		"*.css",
		"*.md",
		"inputs/openapi.json"
	],
	"printWidth": 80,
	"semi": true,
	"singleQuote": false,
	"tabWidth": 2,
	"trailingComma": "all",
	"useTabs": true
}
