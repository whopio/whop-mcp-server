{
	"name": "whop-mcp-server",
	"version": "0.0.1",
	"private": true,
	"description": "The official public source for Whop's hosted, OAuth-enabled MCP server.",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/whopio/whop-mcp-server.git"
	},
	"homepage": "https://github.com/whopio/whop-mcp-server#readme",
	"packageManager": "pnpm@10.23.0",
	"engines": {
		"node": ">=22",
		"pnpm": ">=10"
	},
	"pnpm": {
		"overrides": {
			"ip-address@10.1.0": "10.3.1",
			"ws@8.18.0": "8.21.0",
			"ws@8.18.2": "8.21.0",
			"undici@7.28.0": "7.29.0",
			"minimatch@3.1.2": "3.1.5",
			"minimatch@9.0.5": "9.0.8",
			"minimatch@10.0.3": "10.2.4",
			"sharp@0.33.5": "0.35.4",
			"sharp@0.35.2": "0.35.4",
			"rollup@4.40.2": "4.63.5",
			"rollup@4.62.2": "4.63.5",
			"picomatch@4.0.3": "4.0.7",
			"picomatch@4.0.5": "4.0.7"
		}
	},
	"devDependencies": {
		"oxfmt": "^0.42.0",
		"oxlint": "^1.55.0"
	},
	"scripts": {
		"build": "pnpm --recursive run build",
		"check": "pnpm check-types && pnpm lint && pnpm test",
		"check-types": "pnpm build && pnpm --recursive run check-types",
		"format": "pnpm --recursive run format",
		"lint": "pnpm --recursive run lint",
		"test": "pnpm --recursive run test"
	}
}
